# =====================================================================
#  TWITCH — app en https://dev.twitch.tv/console/apps
#  Redirect URL de la app (exacta):  http://localhost:3000/callback
# =====================================================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/callback

# Canal a administrar (login, sin la @)
TWITCH_CHANNEL=chaarqueen

# Cuenta con la que el bot escribe en el chat.
# Si la dejas vacía usa la misma cuenta del broadcaster.
TWITCH_BOT_LOGIN=

# =====================================================================
#  DISCORD — bot en https://discord.com/developers/applications
#  Activar "PRESENCE INTENT" y "SERVER MEMBERS INTENT" en Bot > Intents
# =====================================================================
DISCORD_BOT_TOKEN=
# ID numérico del usuario de Discord del streamer (click derecho > Copiar ID)
DISCORD_STREAMER_ID=
# Segundos que una actividad debe mantenerse antes de cambiar la categoría
PRESENCE_DEBOUNCE_SECONDS=45
# Si es true solo loguea lo que haría, sin tocar Twitch
AUTOCAT_DRY_RUN=false
# Arrancar con el auto-categorizador encendido
AUTOCAT_ENABLED=true
# Solo cambiar la categoria si el canal esta en vivo
AUTOCAT_ONLY_WHEN_LIVE=false
# Categoria al cerrar el juego (vacio = no tocar nada)
AUTOCAT_IDLE_CATEGORY=Just Chatting
# Avisar por chat cuando cambia la categoria
AUTOCAT_ANNOUNCE=true

# =====================================================================
#  AGENTE DE ESCRITORIO (agent/, en Rust)
#  Detecta el juego por proceso en la PC del streamer. Es mas confiable
#  que la presencia de Discord y le gana cuando los dos estan activos.
# =====================================================================
# Secreto compartido con agent.toml. Vacio = el endpoint no se levanta.
# Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=
# 0.0.0.0 escucha en todas las interfaces. Con Tailscale podes poner
# directamente tu IP 100.x para no exponerlo tambien a la red local.
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
# El agente ve el proceso real, asi que no necesita esperar tanto
# como la presencia de Discord.
AGENT_DEBOUNCE_SECONDS=15

# =====================================================================
#  RIOT GAMES — https://developer.riotgames.com
# =====================================================================
RIOT_API_KEY=
# Riot ID del streamer:  Nombre#TAG
RIOT_ID=
# Plataforma LoL: la1 la2 na1 euw1 eun1 br1 kr jp1 oc1 tr1 ru
RIOT_PLATFORM=la2
# Región de ruteo: americas europe asia sea
RIOT_REGION=americas

# --- Valorant (wrapper no oficial HenrikDev: https://docs.henrikdev.xyz) ---
HENRIK_API_KEY=
VALORANT_ID=
# Región Valorant: na eu ap kr latam br
VALORANT_REGION=latam

# =====================================================================
#  PIPELINE DE CLIPS
# =====================================================================
CLIPS_ENABLED=true
# Hora local diaria de ejecución (HH:MM, 24h)
CLIPS_RUN_AT=05:00
# Ventana hacia atrás en horas
CLIPS_LOOKBACK_HOURS=24
# Máximo de clips a subir por corrida
CLIPS_MAX=15
# Vistas mínimas para considerar un clip
CLIPS_MIN_VIEWS=3

# --- Google Drive (Service Account) ---
# Ruta al JSON de la service account
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# ID de la carpeta destino. DEBE estar en una Unidad compartida
# (ver README: las service accounts no tienen cuota en "Mi unidad")
GDRIVE_FOLDER_ID=
