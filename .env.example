# =====================================================================
#  TWITCH — app at https://dev.twitch.tv/console/apps
#  The app's Redirect URL (exact):  http://localhost:3000/callback
# =====================================================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/callback

# Channel to manage (login, without the @)
TWITCH_CHANNEL=chaarqueen

# Account the bot writes in chat with.
# If left empty it uses the broadcaster's account.
# NOTE: this is the name chat sees on every message. For it to say
# "BotDucky" you need to register a Twitch account with that name and
# authorize it with:  python tools/auth_twitch.py bot
TWITCH_BOT_LOGIN=

# How the bot names itself in the logs, e.g. BotDucky.
# Chat messages are sent without a prefix.
BOT_NAME=BotDucky

# =====================================================================
#  DISCORD — bot at https://discord.com/developers/applications
#  Enable "PRESENCE INTENT" and "SERVER MEMBERS INTENT" in Bot > Intents
# =====================================================================
DISCORD_BOT_TOKEN=
# Numeric Discord user ID of the streamer (right click > Copy ID)
DISCORD_STREAMER_ID=
# Seconds an activity must hold before the category changes
PRESENCE_DEBOUNCE_SECONDS=45
# How often to re-check even if Discord sends no new event
PRESENCE_CHECK_SECONDS=60
# If true it only logs what it would do, without touching Twitch
AUTOCAT_DRY_RUN=false
# Start with the auto-categorizer on
AUTOCAT_ENABLED=true
# Only change the category while the channel is live
AUTOCAT_ONLY_WHEN_LIVE=false
# Category when the game closes (empty = leave it alone)
AUTOCAT_IDLE_CATEGORY=Just Chatting
# Announce in chat when the category changes
AUTOCAT_ANNOUNCE=true
# Create a Twitch prediction when League of Legends or VALORANT is detected
PREDICTION_ENABLED=true
# Twitch accepts between 30 and 1800 seconds
PREDICTION_WINDOW_SECONDS=300

# =====================================================================
#  DESKTOP AGENT (agent/, in Rust)
#  Detects the game by process on the streamer's PC. It is more reliable
#  than Discord presence and wins over it when both are active.
# =====================================================================
# Secret shared with agent.toml. Empty = the endpoint does not start.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=
# 0.0.0.0 listens on every interface. With Tailscale you can put your
# 100.x IP directly so it is not exposed to the local network too.
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
# The agent sees the real process, so it does not need to wait as long
# as Discord presence.
AGENT_DEBOUNCE_SECONDS=15

# Local control for sending messages from another terminal.
# Keep it on 127.0.0.1: only the bot's PC can use it.
CHAT_CONTROL_HOST=127.0.0.1
CHAT_CONTROL_PORT=8790

# Optional PostgreSQL to keep the history across restarts.
# Requires PostgreSQL with the pgvector extension installed.
DATABASE_URL=

# Optional OpenAI-compatible semantic summary.
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MAX_MESSAGES=300
# Model used to embed the messages. Must be compatible with LLM_BASE_URL.
# With Gemini use: models/gemini-embedding-2 (3072 dims)
# With OpenAI use: text-embedding-3-small (1536 dims, requires migrating the schema)
EMBEDDING_MODEL=models/gemini-embedding-2
# How many texts to embed per API call. Higher means fewer API calls.
EMBEDDING_BATCH_SIZE=20
# Users that must not go into the history, comma-separated.
CHAT_IGNORED_AUTHORS=nightbot


# =====================================================================
#  RIOT GAMES — https://developer.riotgames.com
# =====================================================================
RIOT_API_KEY=
# The streamer's Riot ID, with the tag: Name#TAG
# The # does NOT start a comment unless there is a space before it. Quotes
# are optional, but they keep a stray space from cutting the value.
RIOT_ID=
# LoL platform: la1 la2 na1 euw1 eun1 br1 kr jp1 oc1 tr1 ru
RIOT_PLATFORM=la2
# Routing region: americas europe asia sea
RIOT_REGION=americas

# --- Valorant (unofficial HenrikDev wrapper: https://docs.henrikdev.xyz) ---
HENRIK_API_KEY=
# Same format as RIOT_ID: Name#TAG
VALORANT_ID=
# Valorant region: na eu ap kr latam br
VALORANT_REGION=latam

# =====================================================================
#  CLIPS PIPELINE
# =====================================================================
CLIPS_ENABLED=true
# Daily local run time (HH:MM, 24h)
CLIPS_RUN_AT=05:00
# Look-back window in hours
CLIPS_LOOKBACK_HOURS=24
# Maximum clips to upload per run
CLIPS_MAX=15
# Minimum views for a clip to be considered
CLIPS_MIN_VIEWS=3

# --- Google Drive (Service Account) ---
# Path to the service account JSON
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# ID of the destination folder. It MUST be in a Shared Drive
# (see the README: service accounts have no quota in "My Drive")
GDRIVE_FOLDER_ID=
